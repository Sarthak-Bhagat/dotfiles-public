{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "disableLinewrap": true
  },
  "logo": {
    "source": "~/.config/fastfetch/miku2.txt",
    "type": "file",
    "color": {
      "1": "cyan"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "icons",
    "font",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    {
      "type": "disk",
      "folders": ["/", "/mnt/DATA", "/mnt/WINDOWS", "/mnt/EXT"]
    },
    {
      "type": "command",
      "key": "Disk (DATA)",
      "text": "awk '$3 != \"autofs\" && $2 == \"/mnt/DATA\" {print $2}' /proc/mounts | while read -r m; do df -h --output=used,size,pcent \"$m\" | tail -1 | awk -v m=\"$m\" '{gsub(/%/,\"\",$3); print $1\" / \"$2\" (\"$3\"%) - \"m}'; done"
    },
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
